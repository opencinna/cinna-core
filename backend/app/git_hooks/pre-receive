#!/usr/bin/env python3
"""Team library pre-receive hook.

Passed to every ``git receive-pack`` as ``-c core.hooksPath=<GIT_HOOKS_DIR>``;
the rules live in ``app.services.library.push_policy`` (pure, no database).
Runs under the image venv (``PATH=/app/.venv/bin``, ``PYTHONPATH=/app``).
"""
import os
import sys
from pathlib import Path

# ``<backend>/app/git_hooks/pre-receive`` → make ``app`` importable even when
# PYTHONPATH is not inherited.
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from app.services.library.push_policy import main

sys.exit(main(sys.stdin, os.environ))
