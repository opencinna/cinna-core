#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pillow>=10", "resvg-py>=0.5,<0.6"]
# ///
"""Zip a brand theme package for upload.

    uv run --script scripts/package PACKAGE_DIR [--out FILE.zip]

Validates first and writes nothing when the package is invalid. The zip holds
theme.json and only the assets theme.json references (background candidates
and other loose files stay out), at the zip's root. Default output:
<PACKAGE_DIR>.zip beside the folder.

Exit codes: 0 written, 1 invalid (nothing written), 2 the package could not be read.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import io
import sys
import zipfile
from pathlib import Path
from types import ModuleType

sys.dont_write_bytecode = True


def _skill_lib() -> ModuleType:
    name = "brand_theme_skill_lib"
    if name not in sys.modules:
        path = Path(__file__).resolve().parent / "_lib" / "skill_lib"
        loader = importlib.machinery.SourceFileLoader(name, str(path))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
        sys.modules[name] = module
        loader.exec_module(module)
    return sys.modules[name]


lib = _skill_lib()

# A fixed timestamp keeps the zip byte-identical for identical content.
_ZIP_DATE = (1980, 1, 1, 0, 0, 0)


def build_zip(theme: bytes, assets: dict[str, bytes]) -> bytes:
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for name, data in [(lib.THEME_FILE, theme), *sorted(assets.items())]:
            info = zipfile.ZipInfo(name, date_time=_ZIP_DATE)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o644 << 16
            archive.writestr(info, data)
    return buffer.getvalue()


def run(package_dir: str, out_path: str | None = None, out=None) -> int:
    out = out or sys.stdout
    bt = lib.load()
    try:
        root = lib.package_root(package_dir)
        theme, assets = lib.read_package(bt, str(root))
    except lib.UsageError as exc:
        print(f"ERROR package [unreadable]: {exc}", file=out)
        return 2
    result = bt.validator.check_package(theme, assets)
    if not result.ok:
        for e in result.errors:
            print(f"ERROR {e.path} [{e.code}]: {e.message}", file=out)
        print("Not packaged: fix the errors above (run validate), then package again.", file=out)
        return 1
    referenced = {path: assets[path] for path in result.assets}
    left_out = sorted(set(assets) - set(referenced))
    data = build_zip(theme, referenced)

    # Read it back the way core reads an upload, so what is written is what core accepts.
    check_theme, check_assets = bt.package.read_zip(data)
    if not bt.validator.check_package(check_theme, check_assets).ok:
        print("ERROR package [internal]: the zip did not validate after packaging.", file=out)
        return 1

    target = Path(out_path) if out_path else root.resolve().parent / f"{root.resolve().name}.zip"
    target.write_bytes(data)
    print(f"Wrote {target} ({len(data) // 1024} KB): theme.json + {len(referenced)} asset(s).", file=out)
    if left_out:
        print("Left out (not referenced by theme.json): " + ", ".join(left_out), file=out)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="package", description=__doc__.split("\n\n")[0])
    parser.add_argument("package", help="package folder (theme.json + assets/)")
    parser.add_argument("--out", help="zip file to write (default: <PACKAGE_DIR>.zip beside the folder)")
    args = parser.parse_args(argv)
    return run(args.package, args.out)


if __name__ == "__main__":
    sys.exit(main())
