# Domain
# This would be set to the production domain with an env var on deployment
DOMAIN=localhost

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
MCP_SERVER_BASE_URL=
# Public origin of the BACKEND. Every absolute API URL handed outside the
# platform is built from it: inbound webhooks (server channels, task triggers,
# agent hooks), the consumer-facing Agent REST API base, signed A2A attachment
# links, and the native-client OAuth discovery endpoints.
# Leave empty to fall back to FRONTEND_HOST (single-origin setups).
# Production example:  BACKEND_BASE_URL=https://api.example.com
# Local testing against an external provider: run `make webhook-tunnel`, then
# `make webhook-set-url URL=https://xxxx.a.free.pinggy.link`
BACKEND_BASE_URL=
# Former name, still honoured as a fallback; BACKEND_BASE_URL wins.
WEBHOOK_BASE_URL=
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Cinna Core"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
ENCRYPTION_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
# AI Capabilities
# Google API Keys https://aistudio.google.com/app/api-keys
GOOGLE_API_KEY=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

SENTRY_DSN=

# Google OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"
# Separate redirect URI for credential OAuth (to differentiate from user OAuth)
GOOGLE_CREDENTIALS_REDIRECT_URI="http://localhost:5173/credentials/oauth/callback"
AUTH_WHITELIST_USER_DOMAINS=

# Default role for new non-superuser accounts (password signup and Google OAuth first login).
# Allowed values: "agent-user" (default) or "agent-developer".
# "admin" is not allowed here — use is_superuser for that.
# Unset/empty falls back to "agent-user". A present-but-invalid value fails at startup.
# DEFAULT_USER_ROLE=agent-user

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=cinna-backend
DOCKER_IMAGE_FRONTEND=cinna-frontend

# Default Agent Environment Configuration
# Template name and version used when creating new agents
DEFAULT_AGENT_ENV_NAME=python-env-advanced
DEFAULT_AGENT_ENV_VERSION=1.0.0

# Agent Environments Docker Configuration
# Host path where agent environments are stored (used by docker-compose volume mounts)
# Defaults to ./backend/agent-environments if not set
HOST_AGENT_ENVIRONMENTS_DIR=./backend/agent-environments
# Host path for per-(user, bundle) App Data volumes (used by docker-compose
# volume mounts when bind-mounting /app/workspace/app-data into agent containers)
HOST_APP_DATA_DIR=./backend/data/agents/app-data
# Host path for bundle revision snapshots (BUNDLE_STORAGE_DIR). Must persist
# across backend container recreation so git-versioning dirty-check baselines
# are not lost (a wiped baseline made the dirty check silently report "no changes")
HOST_BUNDLE_STORAGE_DIR=./backend/data/bundles

# Try OpenAI-compatible first, fall back to Gemini
AI_FUNCTIONS_PROVIDERS=gemini

# OpenAI-compatible settings (e.g., Ollama)
OPENAI_COMPATIBLE_BASE_URL=https://ollama.example.com/api/v1
OPENAI_COMPATIBLE_API_KEY=someapikeyhere
OPENAI_COMPATIBLE_MODEL=granite4:latest

# Agent ENV Limits
AGENT_ENV_CPU_LIMIT=2
AGENT_ENV_MEMORY_LIMIT=1024M
AGENT_ENV_CPU_RESERVATION=0.25
AGENT_ENV_MEMORY_RESERVATION=128M
