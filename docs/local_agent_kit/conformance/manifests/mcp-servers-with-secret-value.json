{
  "description": "An MCP server requirement whose env item carries a value (contract 1.17.0). An entry names what a server needs and never a secret, so the value is an error even when the item is marked not secret.",
  "manifest": {
    "contract_version": "1.17.0",
    "id": "0f6d2c1e-8a4b-4c3d-9e2f-1a2b3c4d5e6f",
    "name": "Conformance Agent",
    "slug": "conformance-agent",
    "description": "Answers questions about invoices.",
    "example_prompts": [
      "Which invoices are overdue?"
    ],
    "mcp_servers": [
      {
        "name": "desktop-commander",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@wonderwhy-er/desktop-commander"
        ],
        "auth": "env",
        "env": [
          {
            "name": "DC_API_TOKEN",
            "secret": true,
            "value": "sk-live-not-a-real-token"
          },
          {
            "name": "DC_LOG_LEVEL",
            "secret": false,
            "value": "debug"
          }
        ]
      }
    ]
  },
  "expect": {
    "errors": [
      "mcp_servers.env.value"
    ]
  }
}
