{
  "description": "Five well-formed MCP server requirements (contract 1.17.0): a stdio server from a directory with env names and an explicit null url, an http server signed in with OAuth whose dotted name follows a registry id, a custom sse server with a templated url, a null ref, no auth and an unknown extra key, an http server with a null command, empty args and null auth, and a stdio server named like a domain. Nothing to report.",
  "manifest": {
    "contract_version": "1.17.0",
    "id": "0f6d2c1e-8a4b-4c3d-9e2f-1a2b3c4d5e6f",
    "name": "Conformance Agent",
    "slug": "conformance-agent",
    "description": "Answers questions about invoices.",
    "example_prompts": [
      "Which invoices are overdue?"
    ],
    "mcp_servers": [
      {
        "name": "desktop-commander",
        "ref": {
          "source": "core",
          "id": "desktop-commander"
        },
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@wonderwhy-er/desktop-commander"
        ],
        "auth": "env",
        "env": [
          {
            "name": "DC_LOG_LEVEL"
          },
          {
            "name": "DC_API_TOKEN",
            "secret": true
          }
        ],
        "url": null
      },
      {
        "name": "io.github.linear.mcp",
        "ref": {
          "source": "core",
          "id": "linear"
        },
        "transport": "http",
        "url": "https://mcp.linear.app/mcp",
        "auth": "oauth"
      },
      {
        "name": "team_metrics",
        "ref": null,
        "transport": "sse",
        "url": "https://${METRICS_HOST}/sse",
        "x_host_note": "unknown keys on an entry are preserved"
      },
      {
        "name": "docs-search",
        "transport": "http",
        "url": "https://docs.example.com/mcp",
        "command": null,
        "args": [],
        "auth": null
      },
      {
        "name": "context7.com",
        "ref": {
          "source": "core",
          "id": "context7"
        },
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@upstash/context7-mcp"
        ],
        "auth": "none"
      }
    ]
  },
  "expect": {
    "errors": [],
    "no_warnings": [
      "mcp_servers",
      "mcp_servers.name",
      "mcp_servers.ref",
      "mcp_servers.ref.source",
      "mcp_servers.ref.id",
      "mcp_servers.transport",
      "mcp_servers.url",
      "mcp_servers.command",
      "mcp_servers.args",
      "mcp_servers.auth",
      "mcp_servers.env",
      "mcp_servers.env.name",
      "mcp_servers.env.secret",
      "mcp_servers.env.value"
    ]
  }
}
