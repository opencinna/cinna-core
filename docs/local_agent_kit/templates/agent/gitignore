# Secrets — never committed. Everything layout.json treats as a credential value:
# every dotenv shape (`secret_files`), the credentials.json the platform injects at
# the agent root and under credentials/, and private key material
# (`cloud_import_excludes`). Examples, samples and templates stay tracked.
credentials/.env
credentials/credentials.json
credentials.json
.env
.env.*
*.env
*.pem
*.key
*.p12
!*.example
!*.sample
!*.template

# Claude permission allow rules for this machine (layout.json →
# shared_remote.never_travels). The rest of .claude/ is not ignored here.
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Runtime data — per machine, regenerated
app-data/
temp/

# What the agent builds to publish as Cinna artifacts — one person's output,
# never committed and never shared (layout.json → shared_remote.never_travels)
artifacts/

.DS_Store
